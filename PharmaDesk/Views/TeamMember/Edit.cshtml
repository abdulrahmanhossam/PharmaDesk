@model PharmaDesk.ViewModels.TeamMemberViewModel

@{
    ViewData["Title"] = "Edit Team Member";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Edit Team Member</h4>
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>

<div class="card p-3" style="max-width: 600px;">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="FullName" class="form-label">Full Name *</label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Role" class="form-label">Role *</label>
            <select asp-for="Role" class="form-select">
                <option value="Staff">Staff</option>
                <option value="Admin">Admin</option>
            </select>
            <span asp-validation-for="Role" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NewPin" class="form-label">New PIN (leave blank to keep current)</label>
            <input asp-for="NewPin" type="password" class="form-control" placeholder="Type new PIN to reset" />
            <span asp-validation-for="NewPin" class="text-danger"></span>
            <small class="text-muted">If you want to change the PIN, type it here.</small>
        </div>

        <div class="form-check mb-4">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">Active</label>
        </div>

        <button type="submit" class="btn btn-success">Update</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}