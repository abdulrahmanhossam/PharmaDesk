@{
    ViewData["Title"] = "Dashboard";
    var today = (DateOnly)ViewBag.Today;
}

<!-- الكروت العلوية -->
<div class="row g-3 mb-4">
    <!-- مبيعات اليوم (تظهر للأدمن فقط) -->
    @if (User.IsInRole("Admin"))
    {
        <div class="col-md-4">
            <div class="card p-3 border-primary h-100">
                <div class="text-muted mb-1">Today's Sales</div>
                <div class="fs-2 fw-bold text-primary">
                    $@(((decimal)ViewBag.TodaySalesTotal).ToString("0.00"))
                </div>
            </div>
        </div>
    }

    <!-- عدد الفواتير -->
    <div class="col-md-4">
        <div class="card p-3 h-100">
            <div class="text-muted mb-1">Number of Sales</div>
            <div class="fs-2 fw-bold">@ViewBag.TodaySalesCount</div>
        </div>
    </div>

    <!-- مخزون منخفض -->
    <div class="col-md-4">
        <div class="card p-3 border-warning h-100">
            <div class="text-muted mb-1">Low Stock Medicines</div>
            <div class="fs-2 fw-bold text-warning-custom">@ViewBag.LowStockCount</div>
        </div>
    </div>
</div>

<!-- جدول قرب انتهاء الصلاحية -->
<div class="card p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Close to expiry (next 90 days)</h5>
        <a href="/Report/Expiry" class="btn btn-sm btn-outline-primary">View All</a>
    </div>
    
    <table class="table table-sm align-middle mb-0">
        <thead>
            <tr>
                <th>Medicine</th>
                <th>Batch</th>
                <th>Expires</th>
                <th class="text-center">Qty</th>
            </tr>
        </thead>
        <tbody>
            @{
                var batches = ViewBag.ExpiringBatches as List<PharmaDesk.Models.Batch>;
            }
            @if (batches == null || !batches.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">
                        No medicines are close to expiry. Great!
                    </td>
                </tr>
            }
            else
            {
                foreach (var batch in batches)
                {
                    bool isExpired = batch.ExpiryDate <= today;
                    <tr>
                        <td>
                            @if (isExpired)
                            {
                                <span class="text-danger fw-bold">@batch.Medicine?.Name (expired)</span>
                            }
                            else
                            {
                                <span>@batch.Medicine?.Name</span>
                            }
                        </td>
                        <td>@batch.BatchNumber</td>
                        <td>@batch.ExpiryDate.ToString("yyyy-MM-dd")</td>
                        <td class="text-center">@batch.QuantityInStock</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>