@model IEnumerable<PharmaDesk.Models.TeamMember>

@{
    ViewData["Title"] = "Team Members";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Team Members</h4>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-person-plus"></i> Add Member
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card p-3">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Role</th>
                <th class="text-center">Status</th>
                <th>Created At</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No team members found.</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr class="@(item.IsActive ? "" : "text-muted")">
                    <td>@item.FullName</td>
                    <td>
                        <span class="badge @(item.Role == "Admin" ? "bg-primary" : "bg-secondary")">
                            @item.Role
                        </span>
                    </td>
                    <td class="text-center">
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </td>
                    <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i> Edit / Reset PIN
                        </a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                    title="@(item.IsActive ? "Deactivate" : "Activate")">
                                <i class="bi @(item.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>